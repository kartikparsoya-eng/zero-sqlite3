+
+/* Capture an anchor's current read point. The anchor must be in wal2 mode
+** and currently hold a read transaction (readLock>=0). */
+SQLITE_PRIVATE int sqlite3WalCoReadGet(Wal *pAnchor, WalCoRead *pOut){
+  if( pAnchor==0 || pOut==0 ) return SQLITE_MISUSE;
+  if( !isWalMode2(pAnchor) ) return SQLITE_ERROR;   /* co-read is wal2-only */
+  if( pAnchor->readLock<0 ) return SQLITE_ERROR;    /* anchor not in a read tx */
+  memset(pOut, 0, sizeof(*pOut));
+  pOut->hdr   = pAnchor->hdr;       /* the frame the anchor is pinned at */
+  pOut->eLock = pAnchor->readLock;  /* the part/full lock class it holds */
+  return SQLITE_OK;
+}
+
+/* Arm the next read transaction on pWal to begin at pCoRead's frame instead
+** of the live head. Pass NULL to clear. Mirrors sqlite3WalSnapshotOpen(). */
+SQLITE_PRIVATE void sqlite3WalCoReadOpen(Wal *pWal, const WalCoRead *pCoRead){
+  pWal->pCoRead = pCoRead;
+}
+
+/* Conservative validity check for a co-located begin (fail-closed). Returns
+** true only if the captured wal2 header still matches the live wal-index
+** salt for its file -- i.e. the file holding the captured frames has NOT
+** been reset/rotated since capture. SCAFFOLD: salt-only; a production check
+** must also reconcile the two-file mxFrame2 encoding and backfill state. */
+static int walCoReadStillValid(Wal *pWal, const WalCoRead *pCo){
+  volatile WalIndexHdr *pLive = walIndexHdr(pWal);
+  if( pCo->hdr.iVersion!=WAL_VERSION2 ) return 0;      /* not a wal2 capture */
+  if( pCo->hdr.aSalt[0]!=pLive->aSalt[0] ) return 0;   /* file generation moved */
+  if( pCo->hdr.aSalt[1]!=pLive->aSalt[1] ) return 0;
+  return 1;
+}
+#endif /* SQLITE_ENABLE_WAL2_COREAD */
